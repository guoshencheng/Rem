{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/client/*"],
      "rem-agent-core": ["../core/dist/index.d.ts"]
    }
  },
  "include": ["src/client", "vite.config.ts", "vitest.config.ts"]
}
