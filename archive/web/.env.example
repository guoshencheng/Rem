# 容器外部访问端口
WEB_HOST_PORT=3000

# 容器名
WEB_CONTAINER_NAME=rem-agent-web

# rem-agent session 数据目录
REM_AGENT_DATA_DIR=./.rem-agent

# 用户自定义数据目录，容器内挂载到 /data
USER_DATA_DIR=./data

# LLM 配置（由 rem-agent-core 读取）
# 注意：需要在 .rem-agent/config.json 或 ~/.rem-agent/config.json 中设置 provider: minimax
MINIMAX_API_KEY=sk-xxx
MINIMAX_MODEL=MiniMax-M3

# 运行环境
NODE_ENV=production
