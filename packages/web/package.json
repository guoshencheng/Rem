{
  "name": "rem-agent-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,ui -c cyan,green \"tsx watch src/server.ts\" \"vite\"",
    "build": "rm -rf dist && vite build && tsup src/server.ts --format esm --out-dir dist --clean false",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rem-agent-bridge": "workspace:*",
    "rem-agent-bridge-v2": "workspace:*",
    "rem-agent-core": "workspace:*",
    "rem-agent-routes": "workspace:*",
    "rem-agent-ui": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "github-markdown-css": "^5.9.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vite": "^6.3.0"
  }
}
