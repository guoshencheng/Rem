  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@earendil-works/pi-agent-core": "^0.82.1",
    "@earendil-works/pi-ai": "^0.82.1",
    "@sinclair/typebox": "^0.27.0",
    "ajv": "^8.20.0",
    "bash-parser": "^0.5.0",
    "better-sqlite3": "^12.0.0",
    "glob": "^13.0.6",
    "openai": "^6.42.0",
    "yaml": "^2.7.0"
